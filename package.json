{
  "name": "@lennix1337/pi-hashline",
  "version": "0.1.0",
  "private": true,
  "description": "Line-anchored edits for Pi: read tags each line with LINE:HASH and edit names lines by anchor instead of retyping old text; stale anchors are refused.",
  "author": "lennix1337",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "edit",
    "hashline"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "mutations": "node test/mutations.mjs",
    "verify": "npm run check && npm test"
  },
  "dependencies": {
    "typebox": "1.3.27"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.4.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.2.0"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lennix1337/pi-hashline.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
